{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@rent/domain": "workspace:*",
    "@rent/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.7.4",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rent/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.6"
  }
}
