{
  "name": "rent-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Verified rental marketplace + inspection/guarantee layer + records + PSP-facilitated payments",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "dev": "make dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
